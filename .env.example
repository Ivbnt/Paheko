# Copier ce fichier en .env puis adapter :  cp .env.example .env

# --- Général ---------------------------------------------------------------
TZ=Europe/Paris
PAHEKO_VERSION=1.3.23
# SHA-256 de l'archive paheko-<version>.tar.gz (à changer avec la version)
PAHEKO_SHA256=de094f790bb4448bed641d548e0a3ec85b5ffe5d4a26cb9ddd01b8cb5a400434

# Port exposé sur l'hôte. 127.0.0.1 = accessible seulement en local / via un reverse proxy.
# Mettre 0.0.0.0 pour l'ouvrir sur le réseau.
PAHEKO_BIND=127.0.0.1
PAHEKO_PORT=8080

# URL publique, avec / final. Obligatoire derrière un reverse proxy HTTPS.
# PAHEKO_URL=https://paheko.mon-asso.fr/

# Domaine pour le HTTPS automatique (profil "https" avec Caddy)
# PAHEKO_DOMAIN=paheko.mon-asso.fr

# Clé secrète : laisser vide pour qu'elle soit générée et stockée dans le volume
# PAHEKO_SECRET_KEY=

# --- E-mails (optionnel) ---------------------------------------------------
# SMTP_HOST=smtp.example.org
# SMTP_PORT=587
# SMTP_USER=paheko@example.org
# SMTP_PASSWORD=
# SMTP_SECURITY=STARTTLS        # STARTTLS, TLS, SSL ou NONE
# MAIL_SENDER=paheko@example.org
# MAIL_RETURN_PATH=paheko@example.org
# Adresse qui reçoit les rapports d'erreurs PHP
# MAIL_ERRORS=admin@example.org

# --- Tâches planifiées ------------------------------------------------------
PAHEKO_CRON_TIME=04:00

# --- Sauvegardes ------------------------------------------------------------
BACKUP_ENABLED=true
BACKUP_TIME=03:00
# Dossier de l'hôte où sont écrites les sauvegardes
BACKUP_HOST_DIR=./backups
BACKUP_KEEP_DAILY=14
BACKUP_KEEP_WEEKLY=8
BACKUP_KEEP_MONTHLY=12
